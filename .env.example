# Supabase (publishable anon key — safe for the browser; protected by RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Leave empty to use same-origin /api (proxied by vite.config.ts in dev, vercel.json in prod)
VITE_API_URL=
VITE_NODE_ENV=development
VITE_ALLOW_SIGN_UP=true
# Dev-only screenshot bypass; keep 0
VITE_PREVIEW=0
